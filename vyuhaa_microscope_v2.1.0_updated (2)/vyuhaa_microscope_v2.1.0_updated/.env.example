# Vyuhaa Jetson — environment configuration
# Copy to .env and fill in your values
# Load with: export $(cat .env | xargs) before running main.py

# ── Remote sharing (relay) ───────────────────────────────────────────────────
# Required only when the operator presses "Share Session"
RELAY_URL=wss://relay.vyuhaa.com:8765
MICROSCOPE_ID=clinic-001
API_KEY=your-api-key-from-relay-admin

# ── Optional web UI (OF Connect browser interface) ───────────────────────────
# Set to 1 to start FastAPI server alongside PySide6 app
ENABLE_WEB_UI=0
WEB_UI_PORT=5000

# ── Simulation mode ──────────────────────────────────────────────────────────
# Set to 1 to run without real hardware (development / testing)
VYUHAA_SIMULATION=0

# ── Keepalive tuning ─────────────────────────────────────────────────────────
HEARTBEAT_INTERVAL=10
RECONNECT_DELAY=5

# ── Scan output directory ────────────────────────────────────────────────────
# Default: ~/vyuhaa_scans/<label_timestamp>/
# SCAN_OUTPUT_DIR=/data/vyuhaa_scans
